# ─── Modes ────────────────────────────────────────────────────────────────
# Demo mode (default): everything below works with NO keys. Vault and payments are simulated in-process.
CHAIN_MODE=sim            # sim | rpc
PAY_MODE=sim              # sim | gateway   (gateway = Circle Gateway nanopayments on Arc testnet)
GEMINI_SOURCE=live        # live (falls back to the recorded fixture on error) | fixture
PORT=8787
PUBLIC_URL=http://localhost:8787

# ─── Arc testnet (CHAIN_MODE=rpc) ─────────────────────────────────────────
RPC_URL=https://rpc.testnet.arc.io
DEPLOYMENT=arcTestnet     # reads contracts/deployments/<name>.json   (localhost for a local Hardhat node)
EXPLORER_URL=https://explorer.testnet.arc.io
# Run `npm run keys` to generate these. Fund OWNER and AGENT at https://faucet.circle.com (Arc Testnet).
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
SELLER_1_PRIVATE_KEY=
SELLER_2_PRIVATE_KEY=
SELLER_3_PRIVATE_KEY=
VENUE_PRIVATE_KEY=
SELLER_ADDRESSES=
VENUE_ADDRESS=

# Vault policy used by the deploy script (USDC)
AUTO_APPROVE_LIMIT_USDC=10
DAILY_CAP_USDC=50
VAULT_DEPOSIT_USDC=5

# ─── Circle Gateway nanopayments (PAY_MODE=gateway) ───────────────────────
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# ─── QuickNode Streams ────────────────────────────────────────────────────
QUICKNODE_API_KEY=
QUICKNODE_SECURITY_TOKEN=  # printed by `npm run quicknode:setup`
EVENT_SOURCE=auto          # auto | quicknode | rpc

# ─── ElevenLabs ───────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=       # printed by `npm run elevenlabs:setup`
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal

# ─── Gemini trading (optional; without it trades are paper fills against the live book) ──
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_LIVE_TRADING=false

# ─── Agent policy ─────────────────────────────────────────────────────────
MAX_PRICE_PER_CALL_USD=0.02
DATA_BUDGET_PER_SESSION_USD=0.50
DATA_TOPUP_USD=1
MIN_STAKE_USD=1          # bets smaller than this are not placed (lower it for a small testnet vault)
MIN_EDGE=0.03
MAX_EDGE=0.15
KELLY_FRACTION=0.5
